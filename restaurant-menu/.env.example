# Copy this file to ".env" for local development.
# On Cloudflare Pages add the same two names under Settings > Variables and Secrets.
# Both values are on Supabase: Project Settings > API.
# ONLY use the "anon / public" key here. NEVER put the service_role key in this project.
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR-ANON-PUBLIC-KEY
